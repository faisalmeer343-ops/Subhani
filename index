                <div><label>Registration Fee</label><input id="registrationFee" type="number" value="0" oninput="calculateAdmissionTotal()" /></div>
                <div><label>Monthly Fee</label><input id="monthlyFee" type="number" value="0" oninput="calculateAdmissionTotal()" /></div>
                <div><label>Annual Fee</label><input id="annualFee" type="number" value="0" oninput="calculateAdmissionTotal()" /></div>
                <div><label>Books Fee</label><input id="booksFee" type="number" value="0" oninput="calculateAdmissionTotal()" /></div>
