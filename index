function renderAttendanceSheet(students, mk) {
  // Show day-wise attendance for the given month
  const month = mk.split(' ')[0];
  const year = mk.split(' ')[1];
  const mIdx = MONTHS.indexOf(month);
  const daysInMonth = new Date(parseInt(year), mIdx+1, 0).getDate();
  const dates = [];
  for (let d = 1; d <= daysInMonth; d++) dates.push(d);
  let html = '<div class="table-wrap" style="max-height:400px;"><table><thead><tr><th>Sr#</th><th>Student</th><th>Std No</th>';
  dates.forEach(d => { html += `<th style="font-size:9px;padding:2px 4px;">${d}</th>`; });
  html += '<th>Total</th><th>Present</th><th>Absent</th><th>%</th></tr></thead><tbody>';
  students.forEach((s, i) => {
    let total = dates.length, present = 0, absent = 0;
    html += `<tr><td>${i+1}</td><td>${s.name}</td><td>${s.roll || s.id}</td>`;
    dates.forEach(d => {
      const dateStr = year + '-' + String(mIdx+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
      const rec = attendanceRecords.find(r => r.student_id === s.id && r.date === dateStr);
      const st = rec ? rec.status : '-';
      if (st === 'present') present++;
      if (st === 'absent') absent++;
      const color = st === 'present' ? '#38a169' : st === 'absent' ? '#e53e3e' : st === 'late' ? '#ed8936' : '#ccc';
      const letter = st === 'present' ? 'P' : st === 'absent' ? 'A' : st === 'late' ? 'L' : st === 'leave' ? 'Lv' : '-';
      html += `<td style="text-align:center;color:${color};font-weight:700;font-size:10px;">${letter}</td>`;
    });
    const pct = ((present/Math.max(total,1))*100).toFixed(1);
    html += `<td>${total}</td><td style="color:var(--accent-green);font-weight:700;">${present}</td><td style="color:var(--accent-red);font-weight:700;">${absent}</td><td><strong>${pct}%</strong></td></tr>`;
  });
  html += '</tbody></table></div>';
  return html;
}

