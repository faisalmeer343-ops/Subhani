function updateDashboardToLatest() {
  let lm = currentMonth, ly = currentYear;
  let ld = new Date(parseInt(currentYear), MONTHS.indexOf(currentMonth));
  for (const sid in monthlyData) {
    for (const mk in monthlyData[sid]) {
      const [m, y] = mk.split(' ');
      const d = new Date(parseInt(y), MONTHS.indexOf(m));
      if (d > ld) { ld = d; lm = m; ly = y; }
    }
  }
  document.getElementById('dashMonth').value = lm;
  document.getElementById('dashYear').value = ly;
  updateDashboard();
  renderDashboardMPR();
}

function updateDashboard() {
  const month = document.getElementById('dashMonth').value;
  const year = document.getElementById('dashYear').value;
  const mk = getMonthKey(month, year);
  let paid = 0, bal = 0, prev = 0, active = 0;
  students.forEach(s => {
    if (monthlyData[s.id]?.[mk]) {
      const d = monthlyData[s.id][mk];
      paid += d.paid || 0;
      bal += d.balance || 0;
      prev += d.previous_fee || 0;
      active++;
    }
  });
  document.getElementById('dashStudents').textContent = active;
  document.getElementById('dashCollected').textContent = formatCurrency(paid);
  document.getElementById('dashBalance').textContent = formatCurrency(bal);
  document.getElementById('dashPreviousFee').textContent = formatCurrency(prev);
  document.getElementById('dashPnL').textContent = formatCurrency(paid);
  document.getElementById('topStudents').textContent = students.length;
  document.getElementById('topCollected').textContent = formatCurrency(paid);
  document.getElementById('topBalance').textContent = formatCurrency(bal);
  document.getElementById('dashPeriodLabel').textContent = '(' + month + ' ' + year + ')';

  const tbody = document.getElementById('classBody');
  tbody.innerHTML = '';
  CLASSES.forEach(cls => {
    CLASS_SECTIONS.forEach(sec => {
      const list = students.filter(s => s.class === cls && s.section === sec);
      if (!list.length) return;
      let p = 0, b = 0;
      list.forEach(s => {
        if (monthlyData[s.id]?.[mk]) {
          p += monthlyData[s.id][mk].paid || 0;
          b += monthlyData[s.id][mk].balance || 0;
        }
      });
      const t = p + b;
      const pct = t > 0 ? Math.round((p/t)*100) : 0;
      const status = pct >= 100 ? 'Paid' : pct >= 50 ? 'Partial' : 'Pending';
      const cls2 = pct >= 100 ? 'badge-paid' : pct >= 50 ? 'badge-partial' : 'badge-pending';
      const tr = document.createElement('tr');
      tr.innerHTML = `<td><strong>${cls}</strong></td><td>${sec}</td><td>${list.length}</td><td style="color:var(--accent-green);font-weight:700;">${formatCurrency(p)}</td><td style="color:${b > 0 ? 'var(--accent-red)' : 'var(--accent-green)'};font-weight:700;">${formatCurrency(b)}</td><td><strong>${pct}%</strong></td><td><span class="badge-status ${cls2}">${status}</span></td>`;
      tbody.appendChild(tr);
    });
  });
  updateBackupStats();
  renderDashboardMPR();
}

