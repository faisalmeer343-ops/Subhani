function renderSavedAdmissions() {
  const c = document.getElementById('savedAdmissionsContainer');
  if (!c) return;
  const search = (document.getElementById('savedAdmissionSearch')?.value || '').toLowerCase();
  const cls = document.getElementById('savedAdmissionClassFilter')?.value || 'All';
  let f = savedAdmissions || [];
  if (cls !== 'All') f = f.filter(a => a.class === cls);
  if (search) f = f.filter(a => (a.name+a.id+a.father).toLowerCase().includes(search));
  document.getElementById('savedAdmissionCount').textContent = f.length;
  if (!f.length) { c.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);">No records</div>'; return; }
  c.innerHTML = '';
  f.forEach((a, i) => {
    const div = document.createElement('div');
    div.style.cssText = 'padding:8px 12px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:4px;margin-bottom:4px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;font-size:13px;';
    div.innerHTML = `<div><strong>${a.id}</strong> - ${a.name} (${a.father}) - ${a.class} | Total: ${formatCurrency(a.total_fee||0)} | Bal: ${formatCurrency(a.balance_fee||0)}</div><div><button class="btn btn-primary btn-xs" onclick="editSavedAdmission(${i})">✏️</button><button class="btn btn-danger btn-xs" onclick="deleteSavedAdmission(${i})">🗑️</button></div>`;
    c.appendChild(div);
  });
}
function editSavedAdmission(i) {
  const a = savedAdmissions[i];
  if (!a) return;
  document.getElementById('admName').value = a.name || '';
  document.getElementById('admFather').value = a.father || '';
  document.getElementById('admPhone').value = a.phone || '';
  document.getElementById('admAddress').value = a.address || '';
  document.getElementById('admClass').value = a.class || 'Playgroup';
  document.getElementById('admSection').value = a.section || 'A';
  document.getElementById('admFee').value = a.admission_fee || 0;
  document.getElementById('securityFee').value = a.security_fee || 0;
  document.getElementById('registrationFee').value = a.registration_fee || 0;
  document.getElementById('monthlyFee').value = a.monthly_fee || 0;
  document.getElementById('annualFee').value = a.annual_fee || 0;
  document.getElementById('booksFee').value = a.books_fee || 0;
  document.getElementById('uniformFee').value = a.uniform_fee || 0;
  document.getElementById('stationaryFee').value = a.stationary_fee || 0;
  document.getElementById('othersFee').value = a.others_fee || 0;
  document.getElementById('admDiscount').value = a.discount_percent || 0;
  document.getElementById('recFee').value = a.received_fee || 0;
  calculateAdmissionTotal();
  admissionEditIndex = i;
  document.getElementById('admissionSaveBtn').textContent = '💾 Update';
  document.querySelectorAll('.sidebar button').forEach(b => b.classList.remove('active'));
  document.querySelector('[data-tab="admission"]').classList.add('active');
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-admission').classList.add('active');
}
function deleteSavedAdmission(i) {
  if (!confirm('Delete?')) return;
  savedAdmissions.splice(i, 1);
