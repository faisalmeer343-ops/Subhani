function sendWhatsAppNotification() {
  const sid = document.getElementById('whatsappStudent').value;
  let phone = document.getElementById('whatsappPhone').value.trim();
  const msg = document.getElementById('whatsappMessage').value.trim();
  if (sid && !phone) { const s = getStudent(sid); if (s && s.phone) phone = s.phone; }
  if (!phone) { showToast('⚠️ Phone required', 'error'); return; }
  if (!msg) { showToast('⚠️ Message required', 'error'); return; }
  let p = phone.replace(/[^0-9]/g,'');
  if (p.startsWith('0')) p = '92' + p.slice(1);
  else if (!p.startsWith('92')) p = '92' + p;
  window.open('https://wa.me/' + p + '?text=' + encodeURIComponent(msg), '_blank');
  showToast('💬 Opening', 'success');
}
