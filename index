  filtered.forEach(s => {
    let bal = 0, months = [];
    if (monthlyData[s.id]) {
      const sorted = Object.keys(monthlyData[s.id]).sort((a,b) => {
        const [m1,y1] = a.split(' '); const [m2,y2] = b.split(' ');
        if (y1 !== y2) return parseInt(y1) - parseInt(y2);
        return MONTHS.indexOf(m1) - MONTHS.indexOf(m2);
      });
      months = sorted;
      if (sorted.length) bal = monthlyData[s.id][sorted[sorted.length-1]].balance || 0;
    }
    const badge = s.status === 'Free' ? '🎓' : s.status === 'Discount' ? '💫' : '';
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><strong>${s.id}</strong></td><td>${s.name} ${badge}</td><td>${s.father}</td><td>${s.class}</td><td>${s.section || 'A'}</td><td>${s.phone || '-'}</td><td><span class="badge-status ${bal > 0 ? 'badge-pending' : 'badge-paid'}">${bal > 0 ? formatCurrency(bal) : '✅'}</span></td><td>${months.slice(0,3).map(m => `<span class="badge-month">${m}</span>`).join('')}</td><td style="display:flex;gap:4px;flex-wrap:wrap;"><button class="btn btn-info btn-xs" onclick="viewStudentAccount('${s.id}')">📊</button><button class="btn btn-primary btn-xs" onclick="openEditStudentModal('${s.id}')">✏️</button><button class="btn btn-warning btn-xs" onclick="openAddMonthModal('${s.id}')">📅</button><button class="btn btn-danger btn-xs" onclick="deleteStudentById('${s.id}')">🗑️</button></td>`;
    tbody.appendChild(tr);
  });
}

