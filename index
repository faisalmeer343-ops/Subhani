<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PEN / SUBHANI ACADEMY SCHOOL</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
:root {
  --bg-primary:#f0f4f8; --bg-card:#fff; --border-color:#d0d7de;
  --text-primary:#1a2332; --text-secondary:#4a5568; --text-muted:#8a94a6;
  --accent-blue:#2b6cb0; --accent-gold:#d69e2e; --accent-green:#38a169;
  --accent-red:#e53e3e; --accent-teal:#319795; --accent-orange:#ed8936;
  --font-primary:'Arial','Helvetica',sans-serif; --radius:8px;
  --shadow:0 2px 12px rgba(0,0,0,.08); --shadow-hover:0 4px 24px rgba(0,0,0,.12);
  --sidebar-bg:#1a202c; --sidebar-text:#fff; --sidebar-hover:#2d3748;
  --sidebar-active:#d69e2e; --sidebar-active-bg:#2d3748;
}
body { font-family:var(--font-primary); background:var(--bg-primary); color:var(--text-primary); min-height:100vh; line-height:1.6; font-size:15px; }
::-webkit-scrollbar { width:6px; height:6px; }
::-webkit-scrollbar-thumb { background:var(--accent-blue); border-radius:3px; }

/* TOP BAR */
.top-bar { background:var(--bg-card); padding:10px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; border-bottom:3px solid var(--accent-blue); position:sticky; top:0; z-index:100; box-shadow:var(--shadow); }
.logo-area { display:flex; align-items:center; gap:12px; }
.logo-img { height:48px; width:48px; border-radius:50%; object-fit:contain; background:#fff; padding:4px; border:2px solid var(--accent-blue); }
.logo-box { background:var(--bg-primary); border:2px solid var(--accent-blue); border-radius:var(--radius); padding:3px 12px; text-align:center; line-height:1.2; }
.logo-box .line1 { font-size:13px; font-weight:900; color:var(--accent-gold); letter-spacing:1px; }
.logo-box .line2 { font-size:8px; color:var(--accent-blue); }
.logo-box .line3 { font-size:7px; color:var(--text-muted); }
.title { font-size:18px; font-weight:700; color:var(--accent-blue); }
.title small { font-size:10px; color:var(--text-secondary); font-weight:400; display:block; }
.top-stats { display:flex; gap:8px; font-size:13px; flex-wrap:wrap; }
.top-stats span { background:var(--bg-primary); padding:4px 12px; border-radius:4px; border:1px solid var(--border-color); color:var(--text-secondary); }
.top-stats strong { color:var(--accent-blue); }
.stat-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; }
.stat-dot.green { background:var(--accent-green); }
.stat-dot.blue { background:var(--accent-blue); }
.stat-dot.red { background:var(--accent-red); }

/* SIDEBAR */
.main-container { display:flex; min-height:calc(100vh - 75px); }
.sidebar { width:230px; background:var(--sidebar-bg); padding:8px 0; flex-shrink:0; border-right:2px solid var(--accent-gold); overflow-y:auto; max-height:calc(100vh - 75px); }
.sidebar .section-label { font-size:10px; font-weight:700; text-transform:uppercase; color:var(--accent-gold); padding:10px 16px 4px; letter-spacing:2px; border-top:1px solid rgba(255,255,255,.1); margin-top:4px; background:rgba(214,158,46,.1); }
.sidebar .section-label:first-child { border-top:none; margin-top:0; }
.sidebar button { display:flex; align-items:center; gap:8px; width:100%; padding:9px 16px; background:transparent; border:none; color:var(--sidebar-text); font-size:14px; font-weight:500; text-align:left; cursor:pointer; transition:all .3s; border-left:3px solid transparent; }
.sidebar button:hover { background:var(--sidebar-hover); color:var(--accent-gold); }
.sidebar button.active { background:var(--sidebar-active-bg); color:var(--accent-gold); border-left-color:var(--accent-gold); }

/* CONTENT */
.content { flex:1; padding:16px 20px; overflow-x:auto; background:var(--bg-primary); }
.tab { display:none; }
.tab.active { display:block; animation:fadeIn .3s; }
@keyframes fadeIn { from{opacity:0;transform:translateY(8px);} to{opacity:1;transform:translateY(0);} }

/* CARDS */
.card { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); padding:16px 20px; margin-bottom:14px; box-shadow:var(--shadow); }
.card-title { font-size:18px; font-weight:700; margin-bottom:10px; color:var(--accent-blue); display:flex; align-items:center; gap:8px; border-bottom:2px solid var(--border-color); padding-bottom:6px; }
.card-title .badge { background:var(--accent-blue); color:#fff; font-size:10px; padding:2px 10px; border-radius:12px; }
.card-title .prompt { color:var(--accent-green); }

/* FORMS */
.form-row { display:flex; flex-wrap:wrap; gap:6px 10px; align-items:center; margin-bottom:8px; padding:6px 10px; background:var(--bg-primary); border:1px solid var(--border-color); border-radius:4px; }
.form-row label { font-weight:700; font-size:14px; color:var(--accent-blue); min-width:60px; }
.form-row input, .form-row select, .form-row textarea { padding:7px 12px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:4px; font-size:14px; color:var(--text-primary); flex:1; min-width:80px; }
.form-row input:focus, .form-row select:focus, .form-row textarea:focus { outline:none; border-color:var(--accent-blue); box-shadow:0 0 0 2px rgba(43,108,176,.15); }
.form-row textarea { min-height:40px; resize:vertical; }

/* BUTTONS */
.btn { padding:7px 18px; border:1px solid var(--border-color); border-radius:4px; font-weight:600; font-size:14px; cursor:pointer; transition:all .2s; display:inline-flex; align-items:center; gap:4px; background:var(--bg-card); color:var(--text-secondary); }
.btn:hover { transform:translateY(-1px); box-shadow:var(--shadow-hover); }
.btn-primary { background:var(--accent-blue); color:#fff; border-color:var(--accent-blue); }
.btn-success { background:var(--accent-green); color:#fff; border-color:var(--accent-green); }
.btn-danger { background:var(--accent-red); color:#fff; border-color:var(--accent-red); }
.btn-warning { background:var(--accent-gold); color:#fff; border-color:var(--accent-gold); }
.btn-info { background:var(--accent-teal); color:#fff; border-color:var(--accent-teal); }
.btn-pdf { background:var(--accent-red); color:#fff; border-color:var(--accent-red); }
.btn-whatsapp { background:#25D366; color:#fff; border-color:#25D366; }
.btn-secondary { background:#718096; color:#fff; border-color:#718096; }
.btn-sm { padding:4px 12px; font-size:12px; }
.btn-xs { padding:2px 8px; font-size:11px; }

/* STATS */
.stats-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:12px; margin-bottom:14px; }
.stat-card { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); padding:12px 16px; text-align:center; box-shadow:var(--shadow); }
.stat-card .stat-icon { font-size:22px; margin-bottom:3px; }
.stat-card .label { font-size:12px; color:var(--text-muted); font-weight:600; text-transform:uppercase; }
.stat-card .value { font-size:24px; font-weight:800; margin-top:3px; }
.stat-card .value.gold { color:var(--accent-gold); }
.stat-card .value.green { color:var(--accent-green); }
.stat-card .value.blue { color:var(--accent-blue); }
.stat-card .value.danger { color:var(--accent-red); }

/* TABLES */
.table-wrap { overflow-x:auto; max-height:400px; overflow-y:auto; border:1px solid var(--border-color); border-radius:var(--radius); background:var(--bg-card); }
table { width:100%; border-collapse:collapse; font-size:14px; min-width:600px; }
table th { background:var(--bg-primary); color:var(--accent-blue); padding:8px 12px; text-align:left; position:sticky; top:0; z-index:5; white-space:nowrap; font-weight:700; font-size:13px; text-transform:uppercase; border:1px solid var(--border-color); }
table td { padding:6px 12px; border:1px solid var(--border-color); text-align:left; vertical-align:middle; color:var(--text-secondary); }
table tr:nth-child(even) td { background:var(--bg-primary); }
table tr:hover td { background:rgba(43,108,176,.04); }

.badge-status { padding:2px 10px; border-radius:12px; font-size:11px; font-weight:700; display:inline-block; }
.badge-paid { background:rgba(56,161,105,.15); color:var(--accent-green); }
.badge-pending { background:rgba(229,62,62,.15); color:var(--accent-red); }
.badge-partial { background:rgba(214,158,46,.15); color:var(--accent-gold); }
.badge-month { background:rgba(43,108,176,.1); color:var(--accent-blue); padding:2px 8px; border-radius:10px; font-size:10px; display:inline-block; margin:1px; }

/* MODALS */
.modal { display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,.5); backdrop-filter:blur(4px); }
.modal.show { display:flex; align-items:center; justify-content:center; }
.modal-content { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); padding:20px 24px; max-width:750px; width:95%; max-height:90vh; overflow-y:auto; animation:slideUp .3s; box-shadow:var(--shadow-hover); }
@keyframes slideUp { from{transform:translateY(30px) scale(.98);opacity:0;} to{transform:translateY(0) scale(1);opacity:1;} }
.modal-header { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-color); padding-bottom:10px; margin-bottom:12px; }
.modal-header h2 { color:var(--accent-blue); font-size:20px; font-weight:700; }
.modal-close { background:transparent; color:var(--accent-red); border:1px solid var(--accent-red); border-radius:50%; width:30px; height:30px; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
.modal-close:hover { background:var(--accent-red); color:#fff; }

/* TOAST */
.toast { position:fixed; bottom:20px; right:20px; background:var(--bg-card); border:1px solid var(--border-color); color:var(--text-primary); padding:12px 22px; border-radius:var(--radius); box-shadow:var(--shadow-hover); font-weight:600; z-index:9999; animation:slideUp .3s; display:none; min-width:180px; font-size:14px; border-left:4px solid var(--accent-green); }
.toast.show { display:block; }
.toast.error { border-left-color:var(--accent-red); }
.toast.success { border-left-color:var(--accent-green); }
.toast.info { border-left-color:var(--accent-blue); }

/* ADMISSION GRID */
.admission-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.admission-form-grid .full-width { grid-column:1/-1; }
.admission-form-grid label { font-weight:700; font-size:14px; color:var(--accent-blue); display:block; margin-bottom:3px; }
.admission-form-grid input, .admission-form-grid select { padding:7px 12px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:4px; font-size:14px; color:var(--text-primary); width:100%; }

/* FILE UPLOAD */
.file-upload-wrapper { position:relative; overflow:hidden; display:inline-block; }
.file-upload-wrapper input[type=file] { position:absolute; left:0; top:0; opacity:0; width:100%; height:100%; cursor:pointer; }
.file-upload-btn { display:inline-block; padding:6px 14px; background:var(--accent-blue); color:#fff; border-radius:4px; font-weight:700; font-size:13px; cursor:pointer; }

/* SETTINGS PANEL */
.settings-panel { background:var(--bg-card); border:2px solid var(--accent-gold); border-radius:var(--radius); padding:14px 18px; margin-bottom:14px; display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
.settings-title { font-weight:700; color:var(--accent-blue); font-size:14px; }
.logo-preview { width:48px; height:48px; border:2px solid var(--accent-blue); border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; background:#f7fafc; }
.logo-preview img { width:100%; height:100%; object-fit:cover; }
.remove-logo-btn { padding:5px 12px; background:var(--accent-red); color:#fff; border:none; border-radius:4px; font-weight:700; font-size:12px; cursor:pointer; }
.logo-status { font-size:12px; color:var(--text-muted); font-weight:600; }

/* THEME CUSTOMIZER */
.theme-customizer { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); padding:10px 14px; margin-bottom:14px; display:flex; flex-wrap:wrap; align-items:center; gap:10px; font-size:13px; }
.theme-customizer label { font-weight:700; color:var(--accent-blue); }
.theme-customizer select { padding:5px 10px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:4px; color:var(--text-primary); font-size:13px; }

/* LISTBOX */
.listbox { border:1px solid var(--border-color); border-radius:var(--radius); height:180px; overflow-y:auto; padding:4px 0; background:var(--bg-card); }
.student-item { display:flex; align-items:center; padding:6px 12px; border-bottom:1px solid var(--border-color); font-size:13px; cursor:pointer; color:var(--text-secondary); }
.student-item:hover { background:rgba(43,108,176,.06); }
.student-item.selected { background:rgba(43,108,176,.08); border-left:3px solid var(--accent-gold); }
.id-tag { background:var(--accent-blue); color:#fff; padding:2px 8px; border-radius:10px; font-size:10px; font-weight:700; margin-right:8px; }
.student-item input[type=checkbox] { margin-right:8px; width:15px; height:15px; accent-color:var(--accent-blue); }

/* REPORT BOX */
.report-box { background:var(--bg-primary); color:var(--accent-blue); border-radius:var(--radius); padding:14px 18px; font-family:'Courier New',monospace; font-size:13px; white-space:pre-wrap; max-height:450px; overflow:auto; line-height:1.6; border:1px solid var(--border-color); }

/* ATTENDANCE CHECKBOX */
.attendance-checkbox-group { display:flex; gap:6px; align-items:center; flex-wrap:wrap; justify-content:center; }
.attendance-checkbox-group label { display:flex; align-items:center; gap:2px; font-size:11px; font-weight:600; cursor:pointer; min-width:auto; }
.attendance-checkbox-group label input[type=checkbox] { width:14px; height:14px; accent-color:var(--accent-blue); cursor:pointer; }
.present-check { color:var(--accent-green); }
.absent-check { color:var(--accent-red); }
.late-check { color:var(--accent-orange); }
.leave-check { color:var(--accent-blue); }

/* ============================================================ */
/* ========== 3-COPY VOUCHER (SIDE BY SIDE) ==================== */
/* ============================================================ */
.triple-voucher-wrapper {
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:8px;
  margin:10px auto;
  width:100%;
  max-width:1100px;
}
.voucher-copy {
  background:#fff;
  border:3px double #2b6cb0;
  border-radius:8px;
  padding:10px 12px;
  font-size:10px;
  position:relative;
  page-break-inside:avoid;
}
.voucher-copy::before {
  content:'';
  position:absolute;
  top:3px; left:3px; right:3px; bottom:3px;
  border:1.5px solid #d69e2e;
  border-radius:5px;
  pointer-events:none;
}
.voucher-copy .copy-badge {
  text-align:center;
  font-size:10px;
  font-weight:900;
  color:#fff;
  padding:2px 0;
  border-radius:3px;
  letter-spacing:2px;
  margin-bottom:5px;
}
.voucher-copy.school .copy-badge { background:#2b6cb0; }
.voucher-copy.student .copy-badge { background:#38a169; }
.voucher-copy.bank .copy-badge { background:#d69e2e; }
.voucher-copy .v-header {
  display:flex;
  align-items:center;
  gap:5px;
  border-bottom:2px double #2b6cb0;
  padding-bottom:5px;
  margin-bottom:5px;
}
.voucher-copy .v-logo {
  width:32px; height:32px;
  border:2px solid #2b6cb0;
  border-radius:50%;
  overflow:hidden;
  flex-shrink:0;
  background:#ebf4ff;
  display:flex;
  align-items:center;
  justify-content:center;
}
.voucher-copy .v-logo img { width:100%; height:100%; object-fit:cover; }
.voucher-copy .v-logo .txt { font-size:6px; font-weight:700; color:#2b6cb0; text-align:center; line-height:1.1; }
.voucher-copy .v-school { flex:1; text-align:center; line-height:1.1; }
.voucher-copy .v-school .nm { font-size:10px; font-weight:900; color:#2b6cb0; letter-spacing:.5px; }
.voucher-copy .v-school .ad { font-size:6px; color:#2b6cb0; font-weight:700; }
.voucher-copy .v-school .ph { font-size:6px; color:#666; }
.voucher-copy .v-title {
  text-align:center;
  background:#2b6cb0;
  color:#fff;
  font-size:8px;
  font-weight:700;
  letter-spacing:1px;
  padding:2px 0;
  border-radius:2px;
  margin-bottom:5px;
}
.voucher-copy .v-info {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:2px 4px;
  font-size:7px;
  margin-bottom:5px;
}
.voucher-copy .v-info b { color:#2b6cb0; }
.voucher-copy .v-info .full { grid-column:1/-1; }
.voucher-copy .v-table {
  width:100%;
  border-collapse:collapse;
  font-size:7px;
  margin-bottom:5px;
}
.voucher-copy .v-table th {
  background:#2b6cb0;
  color:#fff;
  padding:2px 4px;
  border:1px solid #2b6cb0;
  font-weight:700;
  text-align:left;
  font-size:6px;
}
.voucher-copy .v-table th:last-child { text-align:right; }
.voucher-copy .v-table td {
  padding:1px 4px;
  border:1px solid #ddd;
  font-size:7px;
}
.voucher-copy .v-table td:last-child { text-align:right; font-weight:700; }
.voucher-copy .v-table tr.total td { background:#f5f3ef; border-top:2px solid #2b6cb0; font-weight:800; font-size:8px; }
.voucher-copy .v-table tr.paid td { color:#2e7d32; font-weight:700; }
.voucher-copy .v-table tr.due td { background:#e8f5e9; border-top:2px solid #2e7d32; font-weight:800; color:#c62828; font-size:8px; }
.voucher-copy .v-table tr.arrears td { background:#fff3e0; color:#e65100; font-weight:700; }
.voucher-copy .v-footer {
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  border-top:1.5px solid #2b6cb0;
  padding-top:4px;
  margin-top:4px;
  font-size:6px;
  color:#666;
}
.voucher-copy .v-sign {
  text-align:center;
}
.voucher-copy .v-sign .ln {
  width:50px;
  border-top:1px solid #333;
  margin-top:12px;
  margin-bottom:2px;
}
.voucher-copy .v-watermark {
  position:absolute;
  top:50%; left:50%;
  transform:translate(-50%,-50%) rotate(-15deg);
  font-size:26px;
  font-weight:900;
  color:rgba(43,108,176,.04);
  letter-spacing:3px;
  pointer-events:none;
  text-align:center;
  line-height:1.1;
  text-transform:uppercase;
  white-space:pre-line;
}
.voucher-copy .v-watermark small { font-size:9px; letter-spacing:2px; display:block; color:rgba(214,158,46,.06); }

/* ============================================================ */
/* ========== MPR (Monthly Progress Report) =================== */
/* ============================================================ */
.mpr-wrapper {
  background:#fff;
  padding:20px 24px;
  border:4px double #2b6cb0;
  border-radius:10px;
  position:relative;
  max-width:100%;
  overflow-x:auto;
}
.mpr-wrapper::before {
  content:'';
  position:absolute;
  top:5px; left:5px; right:5px; bottom:5px;
  border:2px solid #d69e2e;
  border-radius:6px;
  pointer-events:none;
}
.mpr-header {
  display:flex;
  align-items:center;
  gap:12px;
  border-bottom:3px double #2b6cb0;
  padding-bottom:10px;
  margin-bottom:12px;
}
.mpr-logo {
  width:55px; height:55px;
  border:2px solid #2b6cb0;
  border-radius:50%;
  overflow:hidden;
  flex-shrink:0;
  background:#ebf4ff;
  display:flex;
  align-items:center;
  justify-content:center;
}
.mpr-logo img { width:100%; height:100%; object-fit:cover; }
.mpr-logo .txt { font-size:8px; font-weight:700; color:#2b6cb0; text-align:center; line-height:1.1; }
.mpr-title-block { flex:1; text-align:center; }
.mpr-title-block .nm { font-size:20px; font-weight:900; color:#2b6cb0; letter-spacing:3px; }
.mpr-title-block .ad { font-size:10px; color:#2b6cb0; letter-spacing:2px; font-weight:700; }
.mpr-title-block .mt { font-size:9px; color:#d69e2e; letter-spacing:2px; font-style:italic; font-weight:700; }
.mpr-title-block .ph { font-size:8px; color:#666; }
.mpr-badge {
  display:inline-block;
  background:#2b6cb0;
  color:#d69e2e;
  font-size:11px;
  font-weight:900;
  padding:2px 14px;
  border-radius:4px;
  letter-spacing:3px;
  margin-top:3px;
}
.mpr-student-info {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:3px 16px;
  font-size:12px;
  padding:6px 0;
  border-bottom:1px dashed #ddd;
  margin-bottom:8px;
}
.mpr-student-info div { padding:2px 0; }
.mpr-student-info b { color:#2b6cb0; }
.mpr-table {
  width:100%;
  border-collapse:collapse;
  font-size:10px;
  border:2px solid #2b6cb0;
  margin:8px 0;
}
.mpr-table th {
  background:#2b6cb0;
  color:#fff;
  padding:3px 5px;
  border:1px solid #2b6cb0;
  font-weight:900;
  text-align:center;
}
.mpr-table th.l { text-align:left; }
.mpr-table td {
  padding:3px 5px;
  border:1px solid #ddd;
  text-align:center;
  font-weight:600;
}
.mpr-table td.l { text-align:left; }
.mpr-table td.subj { color:#2b6cb0; font-weight:700; text-align:left; padding-left:8px; }
.mpr-table tfoot td { background:#ebf4ff; font-weight:900; border-top:2px solid #2b6cb0; }
.mpr-footer {
  display:flex;
  justify-content:space-between;
  margin-top:12px;
  padding-top:8px;
  border-top:3px double #2b6cb0;
  font-size:10px;
}
.mpr-footer .sign { text-align:center; }
.mpr-footer .sign .ln { width:100px; border-top:2px solid #1a202c; margin:20px auto 3px; }
.mpr-footer .sign .lb { font-weight:700; color:#2b6cb0; font-size:9px; text-transform:uppercase; }

/* Dashboard MPR preview */
.dash-mpr-preview {
  display:flex;
  flex-direction:column;
  gap:8px;
  max-height:400px;
  overflow-y:auto;
  padding:4px;
}
.dash-mpr-card {
  background:var(--bg-card);
  border:1px solid var(--border-color);
  border-left:4px solid var(--accent-blue);
  border-radius:6px;
  padding:8px 12px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:6px;
  font-size:13px;
}
.dash-mpr-card:hover { border-left-color:var(--accent-gold); box-shadow:var(--shadow); }
.dash-mpr-card .info { display:flex; gap:12px; flex-wrap:wrap; }
.dash-mpr-card .info b { color:var(--accent-blue); }
.dash-mpr-card .stat { text-align:right; font-weight:700; }
.dash-mpr-card .stat .pct { color:var(--accent-gold); font-size:15px; }
.dash-mpr-card .stat .gr { color:var(--accent-green); }

/* COMPARATIVE */
.comp-bar-wrap { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:6px; }
.comp-bar { flex:1; min-width:120px; }
.comp-bar .lbl { font-size:10px; color:#666; }
.comp-bar .bar { background:#e2e8f0; border-radius:10px; height:14px; overflow:hidden; }
.comp-bar .bar > div { height:100%; }
.comp-bar .val { font-size:11px; font-weight:700; text-align:right; }

/* PRINT */
@media print {
  .top-bar, .sidebar, .btn, .theme-customizer, .settings-panel, .no-print,
  .form-row .btn, .card .btn, .table-wrap, .stats-grid, .modal, .toast { display:none !important; }
  .content { padding:0 !important; margin:0 !important; background:#fff !important; }
  .card { background:#fff !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  body { background:#fff !important; padding:0 !important; font-size:11px !important; }
  .triple-voucher-wrapper { grid-template-columns:1fr 1fr 1fr !important; gap:4px !important; }
  .voucher-copy { page-break-inside:avoid; }
  .mpr-wrapper { border:4px double #2b6cb0 !important; box-shadow:none !important; }
  @page { margin:8mm; size:A4 landscape; }
}

/* RESPONSIVE */
@media(max-width:992px) {
  .sidebar { width:100%; display:flex; flex-wrap:wrap; border-right:none; border-bottom:2px solid var(--accent-gold); max-height:none; }
  .sidebar .section-label { display:none; }
  .sidebar button { padding:5px 10px; font-size:11px; width:auto; flex:1; min-width:50px; text-align:center; justify-content:center; border-left:none; border-bottom:2px solid transparent; }
  .sidebar button.active { border-left:none; border-bottom-color:var(--accent-gold); }
  .admission-form-grid { grid-template-columns:1fr; }
  .triple-voucher-wrapper { grid-template-columns:1fr !important; }
}
@media(max-width:576px) {
  .stats-grid { grid-template-columns:1fr 1fr; }
  .form-row { flex-direction:column; align-items:stretch; }
}
</style>
</head>
<body>

    <div id="appContainer" style="display:block;">
  <!-- TOP BAR -->
