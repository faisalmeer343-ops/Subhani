  if (!examBlocks.length) { c.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);">No blocks</div>'; return; }
  c.innerHTML = '';
  examBlocks.forEach((b, i) => {
    const div = document.createElement('div');
    div.style.cssText = 'border:2px solid var(--accent-blue);border-radius:6px;padding:10px;margin-bottom:8px;background:var(--bg-card);';
    div.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;"><strong style="color:var(--accent-blue);">📋 ${b.name} (${b.id})</strong><button class="btn btn-danger btn-xs" onclick="deleteExamBlock(${i})">🗑️</button></div><div style="font-size:12px;color:var(--text-secondary);margin-top:4px;">Seats: ${b.fromSeat}-${b.toSeat} | Assigned: ${b.assignedCount}</div>`;
    c.appendChild(div);
  });
}
function generateExamBlock() {
  const name = document.getElementById('examBlockName').value.trim();
  const from = parseInt(document.getElementById('examBlockFrom').value);
  const to = parseInt(document.getElementById('examBlockTo').value);
  if (!name || isNaN(from) || isNaN(to) || from > to) { showToast('⚠️ Invalid', 'error'); return; }
  const cls = document.getElementById('examBlockClass').value;
  const sec = document.getElementById('examBlockSection').value;
  const filtered = students.filter(s => (cls === 'All' || s.class === cls) && (sec === 'All' || s.section === sec));
  let seat = from, assigned = [];
  filtered.forEach(s => { if (seat <= to) assigned.push({ studentId: s.id, name: s.name, seatNo: seat++ }); });
  examBlocks.push({ id: 'EB' + String(examBlockIdCounter++).padStart(3,'0'), name, fromSeat: from, toSeat: to, class: cls, section: sec, students: assigned, totalSeats: to-from+1, assignedCount: assigned.length, created_date: getTodayDate() });
  localStorage.setItem('exam_blocks', JSON.stringify(examBlocks));
  renderExamBlocks();
  showToast('✅ Block created', 'success');
}
function deleteExamBlock(i) { if (!confirm('Delete?')) return; examBlocks.splice(i, 1); localStorage.setItem('exam_blocks', JSON.stringify(examBlocks)); renderExamBlocks(); }
function clearAllExamBlocks() { if (!confirm('Delete all?')) return; examBlocks = []; localStorage.setItem('exam_blocks', JSON.stringify(examBlocks)); renderExamBlocks(); }

