function applyTheme() {
  const theme = document.getElementById('themeSelector').value;
  const font = document.getElementById('fontSelector').value;
  document.documentElement.style.setProperty('--font-primary', font);
  const c = { classic:['#2b6cb0','#d69e2e'], modern:['#276749','#319795'], elegant:['#6b46c1','#d69e2e'], professional:['#1a365d','#a0aec0'], warm:['#c05621','#e53e3e'] };
  const colors = c[theme] || c.classic;
  document.documentElement.style.setProperty('--accent-blue', colors[0]);
  document.documentElement.style.setProperty('--accent-gold', colors[1]);
  showToast('🎨 Theme applied', 'success');
}
function resetTheme() {
  document.getElementById('themeSelector').value = 'classic';
  document.getElementById('fontSelector').value = "'Arial', 'Helvetica', sans-serif";
  applyTheme();
}

// ================================================================
// PHOTO PREVIEW
// ================================================================
function previewPhoto(input) {
  const f = input.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = function(e) {
    const img = new Image();
    img.onload = function() {
      const canvas = document.createElement('canvas');
      let w = img.width, h = img.height;
      if (w > 200 || h > 200) { if (w > h) { h = h * 200 / w; w = 200; } else { w = w * 200 / h; h = 200; } }
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      currentPhotoDataURL = canvas.toDataURL('image/jpeg', 0.7);
      document.getElementById('photoPreviewImg').src = currentPhotoDataURL;
      document.getElementById('photoPreview').style.display = 'block';
      document.getElementById('photoName').textContent = f.name;
    };
    img.src = e.target.result;
  };
  r.readAsDataURL(f);
}
function previewEmpPhoto(input) {
  const f = input.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = function(e) {
    const img = new Image();
    img.onload = function() {
      const canvas = document.createElement('canvas');
      let w = img.width, h = img.height;
      if (w > 200 || h > 200) { if (w > h) { h = h * 200 / w; w = 200; } else { w = w * 200 / h; h = 200; } }
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      currentEmpPhotoDataURL = canvas.toDataURL('image/jpeg', 0.7);
      document.getElementById('empPhotoPreviewImg').src = currentEmpPhotoDataURL;
      document.getElementById('empPhotoPreview').style.display = 'block';
      document.getElementById('empPhotoName').textContent = f.name;
    };
    img.src = e.target.result;
  };
  r.readAsDataURL(f);
}

