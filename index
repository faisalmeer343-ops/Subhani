async function depositFee() {
  if (!currentVoucherStudent) return;
  const amt = parseFloat(document.getElementById('fdAmount').value) || 0;
  if (amt <= 0) { showToast('⚠️ Invalid amount', 'error'); return; }
  const s = currentVoucherStudent;
  const month = document.getElementById('fdMonth').value;
  const year = document.getElementById('fdYear').value;
  const mk = getMonthKey(month, year);
  const method = document.getElementById('fdMethod').value;
  if (!monthlyData[s.id]) monthlyData[s.id] = {};
  if (!monthlyData[s.id][mk]) monthlyData[s.id][mk] = { paid: 0, balance: 0 };
  const d = monthlyData[s.id][mk];
  const actual = Math.min(amt, d.balance || 0);
  d.paid = (d.paid || 0) + actual;
  d.balance = (d.balance || 0) - actual;
  transactions.push({ student_id: s.id, student_name: s.name, class: s.class, section: s.section||'A', month, year, fee_type: 'Deposited', amount: actual, balance: d.balance, date: getTodayDate(), method, received_by: 'Admin' });
  localStorage.setItem('transactions', JSON.stringify(transactions));
  localStorage.setItem('monthly_data', JSON.stringify(monthlyData));
  closeModal('feeDepositModal');
  loadStudents();
  updateDashboard();
  if (currentVoucherStudent) generateTripleVoucherPreview(currentVoucherStudent);
  showToast('💰 Deposited ' + formatCurrency(actual), 'success');
}

