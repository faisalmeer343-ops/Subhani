<script>
// ================================================================
// PEN / SUBHANI ACADEMY SCHOOL - v5.0 COMPLETE JAVASCRIPT
// ================================================================

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const YEARS = ['2020','2021','2022','2023','2024','2025','2026','2027','2028','2029','2030','2031','2032'];
const CLASSES = ['Playgroup','Nursery','Prep','1st','2nd','3rd','4th','5th','6th','7th','8th','9th (Science)','9th (Arts)','10th (Science)','10th (Arts)'];
const CLASS_SECTIONS = ['A','B','C','D'];
const EXCEL_SUBJECTS = ['English','Urdu','Math','Science','Islamiyat','Pakistan Study','Biology','Physics','Chemistry','Tarjmah','Computer','Education','G.Math','G.Science'];

let students = [], transactions = [], monthlyData = {}, savedAdmissions = [];
let attendanceRecords = [], employeeAttendanceRecords = [], resultRecords = [];
let employees = [], payrollRecords = [], examBlocks = [], expenditures = [];
let examBlockIdCounter = 1;
let currentVoucherStudent = null, currentPhotoDataURL = null, currentEmpPhotoDataURL = null;
let admissionEditIndex = -1, editingStudentId = null, selectedMonthStudent = null;
let schoolLogoData = null;
let currentMonth = new Date().toLocaleString('en', { month: 'long' });
let currentYear = new Date().getFullYear().toString();

// ================================================================
// UTILS
// ================================================================
function formatCurrency(n) { return 'Rs.' + Number(n || 0).toLocaleString(); }
function formatDateOnly(d) {
  if (!d) return 'N/A';
  let day, month, year;
  if (typeof d === 'string' && d.includes('-')) {
    const p = d.split('-');
    if (p[0].length === 4) { year = p[0]; month = p[1]; day = p[2]; }
    else { day = p[0]; month = p[1]; year = p[2]; }
  } else if (typeof d === 'string' && d.includes('/')) {
    const p = d.split('/'); day = p[0]; month = p[1]; year = p[2];
  }
  if (!day || !month || !year) return d;
  return String(day).padStart(2,'0') + '-' + String(month).padStart(2,'0') + '-' + year;
}
function getTodayDate() { const t = new Date(); return String(t.getDate()).padStart(2,'0') + '/' + String(t.getMonth()+1).padStart(2,'0') + '/' + t.getFullYear(); }
function getTodayWithMonthName() { const t = new Date(); return t.getDate() + ' ' + MONTHS[t.getMonth()] + ' ' + t.getFullYear(); }
function getTodayDateForFile() { const t = new Date(); return t.getFullYear() + '-' + String(t.getMonth()+1).padStart(2,'0') + '-' + String(t.getDate()).padStart(2,'0'); }
function getMonthKey(m, y) { return m + ' ' + y; }
function getStudent(id) { return students.find(s => s.id === id); }
function getMonthlyData(sid, mk) { return (monthlyData[sid] && monthlyData[sid][mk]) ? monthlyData[sid][mk] : null; }
function getAllStudentMonths(sid) { return monthlyData[sid] ? Object.keys(monthlyData[sid]).sort() : []; }
function getNextMonth(m) { const i = MONTHS.indexOf(m); return i === MONTHS.length-1 ? MONTHS[0] : MONTHS[i+1]; }
function getGrade(p) {
  if (p >= 91) return 'A+';
  if (p >= 81) return 'A';
  if (p >= 71) return 'B+';
  if (p >= 61) return 'B';
  if (p >= 51) return 'C+';
  if (p >= 41) return 'C';
  if (p >= 33) return 'D';
  return 'F';
}
function getGradeColor(g) { const c = {'A+':'#d69e2e','A':'#38a169','B+':'#2b6cb0','B':'#319795','C+':'#ed8936','C':'#e53e3e','D':'#c53030','F':'#e53e3e'}; return c[g] || '#333'; }
function getRemarks(p) { if (p >= 85) return 'Excellent'; if (p >= 75) return 'V.Good'; if (p >= 65) return 'Good'; if (p >= 50) return 'Satisfy'; return 'Poor'; }
function getPositionSuffix(p) { if (p === 1) return 'st'; if (p === 2) return 'nd'; if (p === 3) return 'rd'; return 'th'; }
function showToast(msg, type) {
  type = type || 'success';
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 3200);
}
function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
function getStudentPhoto(id) { const s = getStudent(id); return s ? s.photo : null; }

// ================================================================
// LOGO
// ================================================================
function loadSchoolLogo() {
  try {
    const d = localStorage.getItem('school_logo');
    if (d) {
      schoolLogoData = d;
      updateAllLogos(d);
      const st = document.getElementById('logoStatus');
      if (st) { st.textContent = '✅ Logo uploaded'; st.style.color = 'var(--accent-green)'; }
    }
  } catch(e) {}
}
function updateAllLogos(d) {
  const tb = document.getElementById('topBarLogo');
  if (tb) { tb.src = d || ''; tb.style.display = d ? 'block' : 'none'; }
  const si = document.getElementById('settingsLogoImg');
  const sn = document.getElementById('settingsNoLogo');
  if (si && sn) {
    if (d) { si.src = d; si.style.display = 'block'; sn.style.display = 'none'; }
    else { si.style.display = 'none'; sn.style.display = 'block'; }
  }
}
function uploadSchoolLogo(input) {
  const f = input.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = function(e) {
    schoolLogoData = e.target.result;
    localStorage.setItem('school_logo', schoolLogoData);
    updateAllLogos(schoolLogoData);
    document.getElementById('logoStatus').textContent = '✅ Uploaded';
    document.getElementById('logoStatus').style.color = 'var(--accent-green)';
    showToast('✅ Logo uploaded', 'success');
  };
  r.readAsDataURL(f);
  input.value = '';
}
function removeSchoolLogo() {
  if (!confirm('Remove logo?')) return;
  schoolLogoData = null;
  localStorage.removeItem('school_logo');
  updateAllLogos(null);
  document.getElementById('logoStatus').textContent = 'No logo';
  document.getElementById('logoStatus').style.color = 'var(--text-muted)';
}
function getSchoolLogo() { return schoolLogoData; }
function getLogoHTML() {
  if (schoolLogoData) return '<img src="' + schoolLogoData + '" style="width:100%;height:100%;object-fit:cover;">';
  return '<div style="font-size:9px;font-weight:700;color:#2b6cb0;text-align:center;line-height:1.1;">PEN<br>SUBHANI</div>';
}

// ================================================================
