// ================================================================
// ADMISSION CALCULATION
// ================================================================
function calculateAdmissionTotal() {
  const get = id => parseFloat(document.getElementById(id)?.value) || 0;
  const adm = get('admFee'), sec = get('securityFee'), reg = get('registrationFee');
  const mon = get('monthlyFee'), ann = get('annualFee'), bks = get('booksFee');
  const uni = get('uniformFee'), sta = get('stationaryFee'), oth = get('othersFee');
  const discPct = get('admDiscount');
  let customTotal = 0;
  document.querySelectorAll('#customFeeHeadsContainer .custom-fee-amount').forEach(inp => { customTotal += parseFloat(inp.value) || 0; });
  const gross = adm + sec + reg + mon + ann + bks + uni + sta + oth + customTotal;
  const discAmt = (gross * discPct) / 100;
  const total = gross - discAmt;
  const received = get('recFee');
  const balance = total - received;
  if (document.getElementById('totalFeeDisplay')) document.getElementById('totalFeeDisplay').textContent = 'Rs. ' + total.toLocaleString();
  if (document.getElementById('balanceFee')) document.getElementById('balanceFee').value = balance;
  if (document.getElementById('discountAmount')) document.getElementById('discountAmount').value = discAmt;
}

