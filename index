function sendAttendanceWhatsApp(sid, date, status) {
  const s = getStudent(sid);
  if (!s || !s.phone) { showToast('⚠️ No phone', 'error'); return; }
  const emoji = { present:'✅ Present', absent:'❌ Absent', late:'⏰ Late', leave:'📋 Leave' };
  const msg = `🏫 *PEN / SUBHANI ACADEMY SCHOOL*\n📍 Township Lahore\n📞 0332-4676675\n\n📋 *ATTENDANCE*\n\n👤 ${s.name}\n👨 ${s.father}\n📚 ${s.class} (${s.section||'A'})\n📅 ${formatDateOnly(date)}\n${emoji[status]}\n\n🎓 Excellence Through Knowledge`;
  let p = s.phone.replace(/[^0-9]/g,'');
  if (p.startsWith('0')) p = '92' + p.slice(1);
  else if (!p.startsWith('92')) p = '92' + p;
  window.open('https://wa.me/' + p + '?text=' + encodeURIComponent(msg), '_blank');
}
function sendAllAttendanceWhatsApp() {
  const date = document.getElementById('attDate').value;
  if (!date) { showToast('⚠️ Select date', 'error'); return; }
  const rows = document.querySelectorAll('#attendanceBodyCheckbox tr');
  let count = 0;
  rows.forEach(row => {
    const idCell = row.querySelector('td:nth-child(2)');
    if (!idCell) return;
    const sid = idCell.textContent.trim();
    const s = getStudent(sid);
    if (!s || !s.phone) return;
    const cb = row.querySelector('.att-cb:checked');
    const st = cb ? cb.dataset.status : 'absent';
    if (st !== 'present') {
      setTimeout(() => sendAttendanceWhatsApp(sid, date, st), count * 1500);
      count++;
    }
  });
  if (count > 0) showToast(`💬 Sending ${count} alerts`, 'info');
  else showToast('ℹ️ All present', 'info');
}
