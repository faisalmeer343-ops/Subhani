  const monthly = parseFloat(document.getElementById('amMonthly').value) || 0;
  const exam = parseFloat(document.getElementById('amExam').value) || 0;
  const other = parseFloat(document.getElementById('amOther').value) || 0;
  const lab = parseFloat(document.getElementById('amLabFee').value) || 0;
  const prev = parseFloat(document.getElementById('amPrevious').value) || 0;
  if (!monthlyData[s.id]) monthlyData[s.id] = {};
  const total = monthly + exam + other + lab + prev;
  monthlyData[s.id][mk] = { admission_fee: 0, monthly_fee: monthly, exam_fee: exam, other_fee: other, lab_fee: lab, previous_fee: prev, paid: 0, balance: total, date: getTodayDate() };
  localStorage.setItem('monthly_data', JSON.stringify(monthlyData));
  if (newClass !== s.class || newSection !== (s.section || 'A')) {
    s.class = newClass;
    s.section = newSection;
    localStorage.setItem('students', JSON.stringify(students));
    showToast(`🎓 Promoted to ${newClass}!`, 'success');
  }
  closeModal('addMonthModal');
  loadStudents();
  updateDashboard();
  showToast(`📅 Fee added for ${mk}`, 'success');
