async function saveAdmission() {
  const name = document.getElementById('admName').value.trim();
  const father = document.getElementById('admFather').value.trim();
  if (!name || !father) { showToast('⚠️ Name & Father required', 'error'); return; }
  const get = id => document.getElementById(id)?.value || '';
  const getN = id => parseFloat(document.getElementById(id)?.value) || 0;
  const customFees = collectCustomFees();
  const gross = getN('admFee') + getN('securityFee') + getN('registrationFee') + getN('monthlyFee') + getN('annualFee') + getN('booksFee') + getN('uniformFee') + getN('stationaryFee') + getN('othersFee') + Object.values(customFees).reduce((a,b)=>a+b,0);
  const discPct = getN('admDiscount');
  const discAmt = (gross * discPct) / 100;
  const total = gross - discAmt;
  const received = getN('recFee');
  const balance = total - received;

  const studentData = {
    name, father,
    class: get('admClass'), section: get('admSection'),
    phone: get('admPhone'), address: get('admAddress'),
    dob: get('admDob'), gender: get('admGender'),
    bForm: get('admBForm'), nic: get('admNic'), roll: get('admRoll'),
    admissionDate: get('admDate'), prevClass: get('admPrevClass'), prevSchool: get('admPrevSchool'),
    admission_fee: getN('admFee'),
    security_fee: getN('securityFee'),
    registration_fee: getN('registrationFee'),
    monthly_fee: getN('monthlyFee'),
    annual_fee: getN('annualFee'),
    books_fee: getN('booksFee'),
    uniform_fee: getN('uniformFee'),
    stationary_fee: getN('stationaryFee'),
    others_fee: getN('othersFee'),
    custom_fees: customFees,
    discount_percent: discPct,
    discount_amount: discAmt,
    total_fee: total,
    received_fee: received,
    balance_fee: balance,
    inquiry_source: get('admInquiry'),
    inquiry_notes: get('admInquiryNotes'),
    status: get('admStatus'),
    discount: discPct,
    photo: currentPhotoDataURL,
    created_at: getTodayDate()
  };

  if (admissionEditIndex >= 0) {
    const old = savedAdmissions[admissionEditIndex];
    const updated = { ...studentData, id: old.id };
    savedAdmissions[admissionEditIndex] = updated;
    const idx = students.findIndex(s => s.id === old.id);
    if (idx >= 0) students[idx] = { ...students[idx], ...updated };
    localStorage.setItem('students', JSON.stringify(students));
    localStorage.setItem('saved_admissions', JSON.stringify(savedAdmissions));
    admissionEditIndex = -1;
    document.getElementById('admissionSaveBtn').textContent = '💾 Save Student';
    clearAdmissionForm();
    renderSavedAdmissions();
    loadStudents();
    updateDashboard();
    showToast('✅ Updated', 'success');
    return;
  }

  const id = 'S' + String(students.length+1).padStart(4,'0');
  const student = { ...studentData, id };
  students.push(student);
  localStorage.setItem('students', JSON.stringify(students));
  savedAdmissions.push({ ...studentData, id, saved_date: getTodayDate() });
  localStorage.setItem('saved_admissions', JSON.stringify(savedAdmissions));

  const mk = getMonthKey(currentMonth, currentYear);
  if (!monthlyData[id]) monthlyData[id] = {};
  monthlyData[id][mk] = { admission_fee: studentData.admission_fee, security_fee: studentData.security_fee, registration_fee: studentData.registration_fee, monthly_fee: studentData.monthly_fee, annual_fee: studentData.annual_fee, books_fee: studentData.books_fee, uniform_fee: studentData.uniform_fee, stationary_fee: studentData.stationary_fee, others_fee: studentData.others_fee, custom_fees: customFees, discount_amount: discAmt, previous_fee: 0, paid: received, balance: balance, date: getTodayDate() };
  localStorage.setItem('monthly_data', JSON.stringify(monthlyData));

  alert(`✅ STUDENT ADMITTED!\n\nName: ${name}\nClass: ${studentData.class}\nID: ${id}\nTotal Fee: ${formatCurrency(total)}\nReceived: ${formatCurrency(received)}\nBalance: ${formatCurrency(balance)}`);
  clearAdmissionForm();
  loadStudents();
  updateDashboard();
  renderSavedAdmissions();
  showToast('✅ ' + name + ' admitted', 'success');
}

