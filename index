function updateAccounts() {
  const month = document.getElementById('accMonth').value;
  const year = document.getElementById('accYear').value;
  const mk = getMonthKey(month, year);
  let inc = 0;
  students.forEach(s => { const d = getMonthlyData(s.id, mk); if (d) inc += d.paid || 0; });
  let out = 0;
  expenditures.forEach(e => { if (e.date && e.date.includes(year)) out += e.amount || 0; });
  document.getElementById('accIncome').textContent = formatCurrency(inc);
  document.getElementById('accOutcome').textContent = formatCurrency(out);
  document.getElementById('accPnL').textContent = formatCurrency(inc - out);
}

