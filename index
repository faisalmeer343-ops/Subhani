            <div class="full-width"><label>Father *</label><input id="admFather" placeholder="Father's name" /></div>
            <div><label>DOB (dd/mm/yyyy)</label><input id="admDob" type="date" onchange="updateDobWords()" /><div id="dobWords" style="font-size:13px;color:var(--text-muted);margin-top:2px;">—</div></div>
