function openAddMonthModal(id) {
  const s = getStudent(id);
  if (!s) return;
  selectedMonthStudent = s;
  document.getElementById('addMonthInfo').innerHTML = `<div style="padding:8px;background:var(--bg-primary);border-radius:4px;margin-bottom:10px;"><strong>${s.name}</strong> (${s.id}) | ${s.class}</div>`;
  const existing = getAllStudentMonths(s.id);
  let lm = currentMonth, ly = currentYear;
  if (existing.length) {
    const sorted = [...existing].sort((a,b) => {
      const [m1,y1] = a.split(' '); const [m2,y2] = b.split(' ');
      if (y1 !== y2) return parseInt(y1) - parseInt(y2);
      return MONTHS.indexOf(m1) - MONTHS.indexOf(m2);
    });
    const p = sorted[sorted.length-1].split(' ');
    lm = p[0]; ly = p[1] || currentYear;
  }
  const nm = getNextMonth(lm);
  let ny = ly;
  if (nm === 'January' && lm !== 'January') ny = String(parseInt(ly)+1);
  document.getElementById('amMonth').value = nm;
  document.getElementById('amYear').value = ny;
  document.getElementById('amClass').value = s.class;
  document.getElementById('amSection').value = s.section || 'A';
  let prevBal = 0;
  if (existing.length) {
    const sorted = [...existing].sort((a,b) => {
      const [m1,y1] = a.split(' '); const [m2,y2] = b.split(' ');
      if (y1 !== y2) return parseInt(y1) - parseInt(y2);
      return MONTHS.indexOf(m1) - MONTHS.indexOf(m2);
    });
    const prev = getMonthlyData(s.id, sorted[sorted.length-1]);
    if (prev) {
      prevBal = prev.balance || 0;
      document.getElementById('amMonthly').value = prev.monthly_fee || 0;
      document.getElementById('amExam').value = prev.exam_fee || 0;
      document.getElementById('amOther').value = prev.other_fee || 0;
    }
  }
  document.getElementById('amPrevious').value = prevBal;
  document.getElementById('amPreviousNote').innerHTML = prevBal > 0 ? `⚠️ Previous balance ${formatCurrency(prevBal)} will carry forward.` : '✅ No previous balance.';
  openModal('addMonthModal');
}

function saveNextMonthFee() {
  if (!selectedMonthStudent) return;
  const s = selectedMonthStudent;
  const month = document.getElementById('amMonth').value;
  const year = document.getElementById('amYear').value;
  const mk = getMonthKey(month, year);
