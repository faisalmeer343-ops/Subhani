function downloadBackup() {
  const b = { students, transactions, monthly_data: monthlyData, saved_admissions: savedAdmissions, employees, results: resultRecords, attendance_checkbox: attendanceRecords, employee_attendance_checkbox: employeeAttendanceRecords, payroll: payrollRecords, exam_blocks: examBlocks, expenditures };
  const blob = new Blob([JSON.stringify(b, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = 'PEN_Backup_' + getTodayDateForFile() + '.json'; a.click();
  showToast('💾 Downloaded', 'success');
}
function restoreBackup() {
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.json';
  input.onchange = e => {
    const f = e.target.files[0];
    if (!f) return;
    const r = new FileReader();
    r.onload = ev => {
      try {
        const d = JSON.parse(ev.target.result);
        if (!confirm('Replace all data?')) return;
        if (d.students) { students = d.students; localStorage.setItem('students', JSON.stringify(students)); }
        if (d.transactions) { transactions = d.transactions; localStorage.setItem('transactions', JSON.stringify(transactions)); }
        if (d.monthly_data) { monthlyData = d.monthly_data; localStorage.setItem('monthly_data', JSON.stringify(monthlyData)); }
        if (d.saved_admissions) { savedAdmissions = d.saved_admissions; localStorage.setItem('saved_admissions', JSON.stringify(savedAdmissions)); }
        if (d.employees) { employees = d.employees; localStorage.setItem('employees', JSON.stringify(employees)); }
        if (d.results) { resultRecords = d.results; localStorage.setItem('results', JSON.stringify(resultRecords)); }
        if (d.attendance_checkbox) { attendanceRecords = d.attendance_checkbox; localStorage.setItem('attendance_checkbox', JSON.stringify(attendanceRecords)); }
        if (d.employee_attendance_checkbox) { employeeAttendanceRecords = d.employee_attendance_checkbox; localStorage.setItem('employee_attendance_checkbox', JSON.stringify(employeeAttendanceRecords)); }
        if (d.payroll) { payrollRecords = d.payroll; localStorage.setItem('payroll', JSON.stringify(payrollRecords)); }
        if (d.exam_blocks) { examBlocks = d.exam_blocks; localStorage.setItem('exam_blocks', JSON.stringify(examBlocks)); }
        if (d.expenditures) { expenditures = d.expenditures; localStorage.setItem('expenditures', JSON.stringify(expenditures)); }
        loadStudents();
        updateDashboard();
        updateBackupStats();
        showToast('✅ Restored', 'success');
      } catch(err) { showToast('❌ ' + err.message, 'error'); }
    };
    r.readAsText(f);
  };
  input.click();
}

