      <!-- ================= VOUCHER (3-COPY) ================= -->
      <div class="tab" id="tab-voucher">
        <div style="display:flex;flex-wrap:wrap;gap:14px;">
          <div style="flex:1;min-width:220px;">
            <div class="card">
              <div class="card-title"><span class="prompt">&gt;&gt;&gt;</span> Select Students</div>
              <select id="vClass" style="width:100%;padding:6px;margin-bottom:6px;"></select>
              <select id="vSection" style="width:100%;padding:6px;margin-bottom:8px;"><option>A</option><option>B</option><option>C</option><option>D</option></select>
              <button class="btn btn-primary" onclick="loadVoucherStudents()" style="width:100%;">📋 Load</button>
              <div style="display:flex;align-items:center;gap:8px;margin:8px 0;padding:6px 10px;background:var(--bg-primary);border-radius:4px;">
                <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll()" />
                <label for="selectAllCheckbox" style="font-weight:700;font-size:13px;cursor:pointer;">☑️ Select All</label>
                <span style="margin-left:auto;font-size:13px;color:var(--accent-blue);">Selected: <span id="selectedCount">0</span></span>
              </div>
              <div class="listbox" id="vListbox"><div style="color:var(--text-muted);text-align:center;padding:40px 0;">Select class & load</div></div>
              <button class="btn btn-success" onclick="generateSelectedVouchers()" style="width:100%;margin-top:8px;">📄 Generate 3-Copy Vouchers (One Page)</button>
