function calculateExpTotal() {
  const q = parseFloat(document.getElementById('expQty').value) || 0;
  const r = parseFloat(document.getElementById('expRate').value) || 0;
  document.getElementById('expTotal').value = q * r;
}
function saveExpenditure() {
  const name = document.getElementById('expItemName').value.trim();
  const total = parseFloat(document.getElementById('expTotal').value) || 0;
  if (!name || total <= 0) { showToast('⚠️ Invalid', 'error'); return; }
  expenditures.push({ item: name, qty: parseFloat(document.getElementById('expQty').value) || 1, rate: parseFloat(document.getElementById('expRate').value) || 0, amount: total, date: document.getElementById('expDate').value || getTodayDate() });
  localStorage.setItem('expenditures', JSON.stringify(expenditures));
  loadExpenditure();
  document.getElementById('expItemName').value = '';
  document.getElementById('expQty').value = '1';
  document.getElementById('expRate').value = '0';
  document.getElementById('expTotal').value = '0';
  showToast('✅ Saved', 'success');
}
function loadExpenditure() {
  const c = document.getElementById('expenditureContainer');
  if (!c) return;
  c.innerHTML = '';
  let total = 0;
  expenditures.forEach((e, i) => {
    total += e.amount || 0;
    const div = document.createElement('div');
    div.style.cssText = 'display:flex;justify-content:space-between;padding:6px;background:var(--bg-primary);border-radius:4px;margin-bottom:3px;font-size:13px;';
    div.innerHTML = `<span>${e.item} (${e.qty}×${e.rate}) - ${formatDateOnly(e.date)}</span><span style="color:var(--accent-red);font-weight:700;">${formatCurrency(e.amount)} <button class="btn btn-danger btn-xs" onclick="deleteExp(${i})">✕</button></span>`;
    c.appendChild(div);
  });
  document.getElementById('expCount').textContent = expenditures.length;
  document.getElementById('expGrandTotal').textContent = formatCurrency(total);
}
function deleteExp(i) { expenditures.splice(i,1); localStorage.setItem('expenditures', JSON.stringify(expenditures)); loadExpenditure(); }

