function generateTripleVoucherHTML(s, month, year) {
  const mk = getMonthKey(month, year);
  const d = getMonthlyData(s.id, mk) || {};
  const issueDate = document.getElementById('vIssueDate')?.value || getTodayDateForFile();
  const dueDate = document.getElementById('vDueDate')?.value || '';
  const remarks = document.getElementById('voucherRemarks')?.value || '';

  const fees = {
    'Admission Fee': d.admission_fee || 0,
    'Security Fee': d.security_fee || 0,
    'Registration Fee': d.registration_fee || 0,
    'Monthly Fee': d.monthly_fee || 0,
    'Annual Fee': d.annual_fee || 0,
    'Books Fee': d.books_fee || 0,
    'Uniform Fee': d.uniform_fee || 0,
    'Stationary Fee': d.stationary_fee || 0,
    'Others Fee': d.others_fee || 0
  };
  if (d.custom_fees) Object.assign(fees, d.custom_fees);

  let grossTotal = 0;
  let feeRowsHTML = '';
  Object.entries(fees).forEach(([k, v]) => {
    if (v > 0) {
      grossTotal += v;
      feeRowsHTML += `<tr><td>${k}</td><td style="text-align:right;font-weight:700;">${formatCurrency(v)}</td></tr>`;
    }
  });
  if (d.previous_fee > 0) {
    feeRowsHTML += `<tr class="arrears"><td>🔴 Previous Arrears</td><td style="text-align:right;">${formatCurrency(d.previous_fee)}</td></tr>`;
    grossTotal += d.previous_fee;
  }
  const disc = d.discount_amount || 0;
  if (disc > 0) {
    feeRowsHTML += `<tr style="background:#e8f5e9;"><td style="color:#2e7d32;font-weight:700;">💫 Discount</td><td style="text-align:right;color:#2e7d32;font-weight:700;">- ${formatCurrency(disc)}</td></tr>`;
  }
  const netTotal = grossTotal - disc;
  const paid = d.paid || 0;
  const balance = netTotal - paid;

  feeRowsHTML += `<tr class="total"><td>💰 TOTAL</td><td style="text-align:right;">${formatCurrency(netTotal)}</td></tr>`;
  feeRowsHTML += `<tr class="paid"><td>✅ Paid</td><td style="text-align:right;">${formatCurrency(paid)}</td></tr>`;
  feeRowsHTML += `<tr class="due"><td>📊 DUE</td><td style="text-align:right;">${formatCurrency(balance)}</td></tr>`;

  const buildCopy = (type, label, badgeColor) => `
    <div class="voucher-copy ${type}">
      <div class="copy-badge" style="background:${badgeColor};">${label}</div>
      <div class="v-watermark">PEN<br>SUBHANI<br><small>ACADEMY</small></div>
      <div class="v-header">
        <div class="v-logo">${schoolLogoData ? `<img src="${schoolLogoData}">` : '<div class="txt">PEN<br>SUBHANI</div>'}</div>
        <div class="v-school">
          <div class="nm">PEN / SUBHANI ACADEMY</div>
          <div class="ad">24, 25-2-B2 (Opp 1122 Rescue) Township Lahore</div>
          <div class="ph">📞 0332-4676675, 0321-4289807</div>
        </div>
      </div>
      <div class="v-title">FEE VOUCHER — ${month.toUpperCase()} ${year}</div>
      <div class="v-info">
        <div><b>ID:</b> ${s.id}</div>
        <div><b>Name:</b> ${s.name}</div>
        <div><b>Father:</b> ${s.father}</div>
        <div><b>Class:</b> ${s.class} (${s.section || 'A'})</div>
        <div><b>Issue Date:</b> ${formatDateOnly(issueDate)}</div>
        <div><b>Due Date:</b> <span style="color:#c62828;font-weight:700;">${dueDate ? formatDateOnly(dueDate) : 'As per policy'}</span></div>
      </div>
      <table class="v-table">
        <thead><tr><th>PARTICULARS</th><th>AMOUNT (Rs.)</th></tr></thead>
        <tbody>${feeRowsHTML}</tbody>
      </table>
      ${remarks ? `<div style="font-size:6px;padding:2px 4px;background:#e3f2fd;border-left:2px solid #0d47a1;margin-bottom:3px;color:#555;"><b>Remarks:</b> ${remarks}</div>` : ''}
      <div class="v-footer">
        <div>
          <div>💳 Easypesa: 0332-4676675</div>
          <div>🏦 Soneri Bank: 20016698537</div>
        </div>
        <div class="v-sign"><div class="ln"></div>Authorized Signature</div>
      </div>
      <div style="text-align:center;font-size:6px;color:#888;margin-top:3px;">Excellence Through Knowledge</div>
    </div>`;

  return `<div class="triple-voucher-wrapper">
    ${buildCopy('school', '📋 SCHOOL COPY', '#2b6cb0')}
    ${buildCopy('student', '📋 STUDENT COPY', '#38a169')}
    ${buildCopy('bank', '🏦 BANK COPY', '#d69e2e')}
  </div>`;
}

