            <div><label>Phone</label><input id="admPhone" placeholder="03XXXXXXXXX" /></div>
            <div class="full-width"><label>Address</label><input id="admAddress" placeholder="Address" /></div>
            <div><label>B-Form No</label><input id="admBForm" /></div>
            <div><label>Father/Guardian NIC</label><input id="admNic" /></div>
            <div><label>Class</label><select id="admClass"><option>Playgroup</option><option>Nursery</option><option>Prep</option><option>1st</option><option>2nd</option><option>3rd</option><option>4th</option><option>5th</option><option>6th</option><option>7th</option><option>8th</option><option>9th (Science)</option><option>9th (Arts)</option><option>10th (Science)</option><option>10th (Arts)</option></select></div>
            <div><label>Section</label><select id="admSection"><option>A</option><option>B</option><option>C</option><option>D</option></select></div>
