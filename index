function renderSubjectSheet() {
  const cls = document.getElementById('ssClass').value;
  const subj = document.getElementById('ssSubject').value;
  const month = document.getElementById('ssMonth').value;
  const year = document.getElementById('ssYear').value;
  const mk = getMonthKey(month, year);
  const filtered = students.filter(s => s.class === cls);
  const tbody = document.getElementById('subjectSheetBody');
  tbody.innerHTML = '';
  if (!filtered.length) { tbody.innerHTML = '<tr><td colspan="21" style="padding:14px;text-align:center;color:var(--text-muted);">No students</td></tr>'; return; }
  const rows = [];
  filtered.forEach(s => {
    const md = monthlyData[s.id]?.[mk] || {};
    const sd = md[subj] || {};
    let t = 0, o = 0;
    for (let i = 1; i <= 6; i++) { t += sd[`test${i}_total`] || 0; o += sd[`test${i}_obtained`] || 0; }
    rows.push({ s, sd, t, o, pct: t>0?o/t*100:0 });
  });
  rows.sort((a,b) => b.pct - a.pct);
  rows.forEach((r, i) => {
    const grade = getGrade(r.pct);
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${i+1}</td><td>${r.s.name}</td><td>${r.s.id}</td>${[1,2,3,4,5,6].map(t => `<td style="text-align:center;padding:2px 4px;">${r.sd[`test${t}_total`] || '-'}</td><td style="text-align:center;padding:2px 4px;">${r.sd[`test${t}_obtained`] || '-'}</td>`).join('')}<td style="font-weight:700;">${r.t}</td><td style="font-weight:700;color:var(--accent-blue);">${r.o}</td><td style="color:var(--accent-gold);font-weight:700;">${r.pct.toFixed(1)}%</td><td style="color:${getGradeColor(grade)};font-weight:700;">${grade}</td><td>${i+1}${getPositionSuffix(i+1)}</td><td><button class="btn btn-primary btn-xs" onclick="editSubjectMarks('${r.s.id}', '${subj}', '${mk}')">✏️</button></td>`;
    tbody.appendChild(tr);
  });
}

function editSubjectMarks(sid, subj, mk) {
  const s = getStudent(sid);
  if (!s) return;
  const md = monthlyData[sid]?.[mk] || {};
  const sd = md[subj] || {};
  let msg = `Edit marks for ${s.name} - ${subj} (${mk})\n\nEnter comma-separated: Test1_TM,Test1_OM,Test2_TM,Test2_OM,... (6 tests)\n\nCurrent values:\n`;
  for (let i = 1; i <= 6; i++) {
    msg += `Test-${i}: ${sd[`test${i}_total`] || 0} / ${sd[`test${i}_obtained`] || 0}\n`;
  }
  const input = prompt(msg + '\n\nEnter: TM,OM,TM,OM,TM,OM,TM,OM,TM,OM,TM,OM');
  if (!input) return;
  const parts = input.split(',').map(x => parseFloat(x) || 0);
  if (!monthlyData[sid]) monthlyData[sid] = {};
  if (!monthlyData[sid][mk]) monthlyData[sid][mk] = {};
  if (!monthlyData[sid][mk][subj]) monthlyData[sid][mk][subj] = {};
  for (let i = 1; i <= 6; i++) {
    monthlyData[sid][mk][subj][`test${i}_total`] = parts[(i-1)*2] || 0;
    monthlyData[sid][mk][subj][`test${i}_obtained`] = parts[(i-1)*2+1] || 0;
  }
  localStorage.setItem('monthly_data', JSON.stringify(monthlyData));
  renderSubjectSheet();
  showToast('✅ Marks updated', 'success');
}

function printSubjectSheet() { window.print(); }

